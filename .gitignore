# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.env
.env.*
!.env.example

# Live client dart-define config (project-specific values; keep out of git —
# only config/gemini-live.example.json is committed). The GEMINI_API_KEY is
# NEVER a client dart-define; it lives only as a server-side Supabase secret.
config/gemini-live.json
config/*.local.json

# Supabase CLI local link metadata (per-machine; never commit)
supabase/.temp/
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
.tools/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
